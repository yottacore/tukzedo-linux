##	Once per boot, after the stock ZFS and fstab mounts: make every mountpoint dir empty and immutable,
##	mount any canmount=on dataset that was missed, and quarantine anything hidden under a live mount.
##	Runs before user sessions open. A failure here never blocks logins.

[Unit]
Description=Check and lock down ZFS and other mountpoint dirs
Documentation=file:/usr/local/sbin/tkz_zfs-mount
After=zfs-mount.service local-fs.target
Before=systemd-user-sessions.service display-manager.service
ConditionFileIsExecutable=/usr/local/sbin/tkz_zfs-mount

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/tkz_zfs-mount --audit-all
TimeoutStartSec=2min

[Install]
WantedBy=multi-user.target
