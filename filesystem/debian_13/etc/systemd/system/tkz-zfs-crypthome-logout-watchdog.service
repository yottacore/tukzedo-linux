##	Lock (unmount + unload key) the encrypted ZFS homes of users who have logged out.
##	Started every 5 minutes by the matching .timer, and immediately at logout by the pam_exec
##	close_session line in /etc/pam.d/common-session. Both 'systemctl start' this unit, and a start
##	while it's running joins that job, so only one runs at a time.

[Unit]
Description=Lock encrypted ZFS homes of logged-out users
Documentation=file:/usr/local/sbin/tkz_zfs-crypthome_logout-watchdog
After=zfs-mount.service systemd-logind.service
ConditionFileIsExecutable=/usr/local/sbin/tkz_zfs-crypthome_logout-watchdog

[Service]
Type=oneshot
## When PAM closes a session, logind still shows it as 'closing' for a bit.
ExecStartPre=/bin/sleep 5
ExecStart=/usr/local/sbin/tkz_zfs-crypthome_logout-watchdog --unattended
## A run stuck on a busy mount would hold the flock and make every later run exit early. A oneshot
## is 'activating' for all of ExecStart, so the start timeout is what kills it (whole cgroup).
## Both timeouts together stay under the 5-minute timer period.
TimeoutStartSec=4min
TimeoutStopSec=30s
