##	Purpose:
##		- Checks that the ESP is mounted and readable at '/boot/efi' after the local and ZFS mounts are
##		  done, and repairs it if not.
##		- A backup only. 'boot-efi.mount', from '/etc/fstab' with 'x-systemd.after=zfs-import.target',
##		  normally mounts it. This catches it getting shadowed by a later mount over '/boot'.
##	Notes:
##		- Replaces '/etc/rc.localx9.d/020-insure-efi-mount', which used a 'sleep' instead of unit ordering.
##		- No 'ConditionPathIsMountPoint=!/boot/efi', since it also has to catch a mount that reads as empty.
##	History:
##		- 20260813 JC: Created.

[Unit]
Description=Ensure the EFI system partition is mounted at /boot/efi
Documentation=file:/usr/local/sbin/tkz_insure-efi-mount
ConditionPathExists=/boot/efi

## After everything that could mount or shadow '/boot/efi'.
After=local-fs.target
After=zfs-import.target
After=zfs-mount.service
After=boot-efi.mount
Wants=boot-efi.mount

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/sbin/tkz_insure-efi-mount /boot/efi --wait 15

## A failure here needs fixing by hand, but mustn't block the boot.
SuccessExitStatus=0
TimeoutStartSec=120

## Light hardening only. A private mount namespace (PrivateTmp, ProtectSystem=strict, ReadOnlyPaths)
## would hide its mounts from the rest of the system.
NoNewPrivileges=yes
ProtectHome=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes

[Install]
WantedBy=multi-user.target
