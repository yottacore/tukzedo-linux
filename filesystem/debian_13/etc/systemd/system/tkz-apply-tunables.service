##	Purpose:
##		- Applies '/etc/tukzedo/tunables.conf' on every boot, and reports what it changed.
##	Notes:
##		- The native drop-ins from 'tkz_apply-tunables --emit-native' apply most of these at the right
##		  time: systemd-sysctl, the initrd and modprobe, and udev for hotplugged disks.
##		- This unit is the backup and the log. It catches an initrd not rebuilt yet, or drop-ins not
##		  regenerated after a config change.
##		- Runs after systemd-sysctl, so it reports on the result instead of racing it.
##	History:
##		- 20260813 JC: Created, replacing '/etc/rc.localx9.d/010-set-kernel-params'.

[Unit]
Description=Apply Tukzedo kernel and system tunables
Documentation=file:/etc/tukzedo/tunables.conf
Documentation=file:/usr/local/sbin/tkz_apply-tunables
ConditionPathExists=/etc/tukzedo/tunables.conf

After=systemd-sysctl.service
After=systemd-modules-load.service
After=local-fs.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/sbin/tkz_apply-tunables

## A tunable that won't take gets reported, but never fails the boot.
SuccessExitStatus=0 1
TimeoutStartSec=60

## It writes to /proc/sys and /sys, so no sandboxing that makes those read-only.
NoNewPrivileges=yes
ProtectHome=yes
ProtectHostname=yes
PrivateNetwork=no
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes

[Install]
WantedBy=multi-user.target
