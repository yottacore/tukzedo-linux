#!/bin/bash
#  shellcheck disable=2155  ## Disable check to 'Declare and assign separately to avoid masking return values'.
#  shellcheck disable=2120  ## 'References arguments, but none are ever passed.' Valid function argument overloading.

##	Purpose:
##		- Makes sure the ZFS pools a host needs get imported at boot, however often the drive has moved
##		  between hosts. The stock import runs once, without '-f', and gives up. This one retries, forces
##		  past a stale hostid, and never uses or leaves a cache file.
##		- One script for both halves of the boot:
##			- In the initrd, the '99tkz-zfs-import' dracut module runs it as '--root', after the stock
##			  'zfs-import-scan.service'. It imports the pool named by 'root=ZFS=' on the kernel command line.
##			- In the real system, 'tkz-zfs-import.service' runs it as '--clear-cache --declared', before
##			  the stock 'zfs-import-scan.service'. It imports the pools listed in '/etc/tukzedo/zfs-pools.conf'.
##	Syntax:
##		tkz_zfs-import  [options]  [pool ...]
##	Options:
##		    --root ...........: Import the pool named by 'root=ZFS=' or 'root=zfs:' on the kernel command line.
##		                        Also activates the 'rd.lvm.lv=' volumes before each try, since the stock
##		                        initrd import doesn't wait for LVM.
##		    --declared .......: Import the pools listed in '/etc/tukzedo/zfs-pools.conf'.
##		    --clear-cache ....: Set 'cachefile=none' on every imported pool, and delete '/etc/zfs/zpool.cache'.
##		                        Runs before any import in the same call.
##		    --timeout <sec> ..: Keep retrying for this long. Default 60 for '--root' (or 'rd.tkz.zfs_import_timeout='
##		                        on the kernel command line), else IMPORT_TIMEOUT from the config file, else 30.
##		-h, --help ...........: This.
##	Exit codes:
##		0 = every requested pool is imported (or there was nothing to do).
##		1 = at least one pool still isn't imported after the timeout. The reason is logged.
##		2 = usage error.
##	Notes:
##		- Each try imports without '-f' first, so the log says when force was needed and which host had
##		  the pool last. Then it retries with '-f'.
##		- '-f' skips the check that stops two hosts importing the same pool at once. That's only a risk
##		  when a disk really is imported on another running system, such as a host that passes the disk
##		  through to a VM while it still has the pool imported. Export it there first.
##		- Every import uses '-N' and '-o cachefile=none'. Datasets are mounted by the stock units later.
##		- Output goes to stdout. In the initrd the unit sends it to the console too; in the real system it
##		  also goes to 'tkz_startup-log', when that's installed:
##			journalctl -b -u tkz-zfs-import-root.service -u tkz-zfs-import.service
##	Copyright and license ...: Toward bottom of this file.
##	History .................: At bottom of this file.

##	Copyright © 2026 Jim Collier [ID: 2უNაɘ«҂թȹɤξπ๙¿ձϖ]
##	Licensed under The GNU General Public License v2.0 or later.
##		https://spdx.org/licenses/GPL-2.0-or-later.html
##	SPDX-License-Identifier: GPL-2.0-or-later


set -euo pipefail

## Plain parameter expansion, not basename/readlink. This also runs in the initrd, which may lack them.
declare -r meName="${0##*/}"
declare -r startupLogger="/usr/local/sbin/tkz_startup-log"
declare -r POOLS_CONF="/etc/tukzedo/zfs-pools.conf"
declare -r CACHE_FILE="/etc/zfs/zpool.cache"
declare -ri RETRY_INTERVAL=2

## Options
declare -i doRoot=0
declare -i doDeclared=0
declare -i doClearCache=0
declare    timeoutArg=""
declare -a argPools=()

## Filled in by fMain().
declare -a lvmVolumes=()


function fLog(){
	echo "[ ${meName}: $* ]"
	[[ -x "${startupLogger}" ]]  &&  "${startupLogger}" "${0}" note "$*"  ||  true
}

function fLogBegin(){ [[ -x "${startupLogger}" ]] && "${startupLogger}" "${0}" begin "$*" || true; }
function fLogEnd(){   [[ -x "${startupLogger}" ]] && "${startupLogger}" "${0}" end   "$*" || true; }


function fShowSyntax(){
	echo
	sed -n '/^##\tSyntax:/,/^##\tNotes:/p' "${0}" | sed '$d' | sed 's/^##\t\?//; s/^\t/  /'
	echo
}


function fThrowUsageError(){
	echo >&2
	echo "${meName}: $*" >&2
	echo "Try '${meName} --help'." >&2
	echo >&2
	exit 2
}


function fParseArgs(){
	while [[ "$#" -gt 0 ]]; do
		case "${1,,}" in
			"--root")         doRoot=1;       shift ;;
			"--declared")     doDeclared=1;   shift ;;
			"--clear-cache")  doClearCache=1; shift ;;
			"--timeout")      [[ "$#" -ge 2 ]] || fThrowUsageError "'--timeout' needs a value."
			                  timeoutArg="$2"; shift 2 ;;
			"-h"|"--help")    fShowSyntax; exit 0 ;;
			-*)               fThrowUsageError "Unrecognized option: '$1'." ;;
			*)                argPools+=("$1"); shift ;;
		esac
	done

	[[ -z "${timeoutArg}" ]] || [[ "${timeoutArg}" =~ ^[0-9]+$ ]]  ||  fThrowUsageError "'--timeout' needs a whole number of seconds."
	((doRoot || doDeclared || doClearCache)) || [[ "${#argPools[@]}" -gt 0 ]]  ||  fThrowUsageError "Nothing to do. Give '--root', '--declared', '--clear-cache' or a pool name."
}


function fInsureRoot(){
	[[ "${EUID}" -eq 0 ]]  &&  return 0
	local nextArg=""
	for nextArg in "$@"; do [[ "${nextArg,,}" == "-h" || "${nextArg,,}" == "--help" ]]  &&  return 0; done
	command -v sudo &>/dev/null  ||  { echo "${meName}: must run as root." >&2; exit 1; }
	echo "[ ${meName}: not root; re-executing via sudo ... ]"
	exec sudo -- "${0}" "$@"
}


##•••••••••••••••••••••••••••••••••••••••••••••••••••••••••••••••••••••••••••••
##	Where the pool names come from.
##•••••••••••••••••••••••••••••••••••••••••••••••••••••••••••••••••••••••••••••

function fGetCmdlineArgs(){
	## Prints the value of every '<name>=<value>' on the kernel command line, one per line.
	local -r argName="${1}"
	local -a cmdlineArr=()
	local    nextArg=""
	read -r -a cmdlineArr < /proc/cmdline || true
	for nextArg in "${cmdlineArr[@]}"; do
		[[ "${nextArg}" == "${argName}="* ]]  &&  echo "${nextArg#"${argName}="}"
	done
	return 0
}


function fGetLastCmdlineArg(){
	## The last one wins, as with the kernel's own parsing.
	local -a values=()
	readarray -t values < <(fGetCmdlineArgs "${1}")
	[[ "${#values[@]}" -gt 0 ]]  &&  echo "${values[-1]}"
	return 0
}


function fOneLine(){ local str="${1//$'\n'/ }"; echo "${str//  / }"; }


function fIndent(){ local line=""; while IFS= read -r line; do echo "    ${line}"; done; }


function fGetRootPool(){
	## Same forms the stock 'decode_root_args' accepts, minus autodetection: 'root=ZFS=pool/ds', 'root=zfs:pool/ds'.
	local rootArg="$(fGetLastCmdlineArg root)"
	case "${rootArg}" in
		""|zfs|zfs:|zfs:AUTO)  return 0 ;;  ## Autodetect: the pool name isn't known in advance.
		ZFS=*|zfs:*)           rootArg="${rootArg#zfs:}"; rootArg="${rootArg#ZFS=}" ;;
		*)                     return 0 ;;  ## Not ZFS on root.
	esac
	rootArg="${rootArg//+/ }"
	echo "${rootArg%%/*}"
}


function fGetDeclaredPools(){
	## Prints the pools listed in the config file, one per line.
	[[ -f "${POOLS_CONF}" ]]  ||  return 0
	local -a ZFS_POOLS=()
	# shellcheck source=/dev/null
	source "${POOLS_CONF}"
	local nextPool=""
	for nextPool in "${ZFS_POOLS[@]}"; do
		[[ -n "${nextPool}" ]]  &&  echo "${nextPool}"
	done
	return 0
}


function fGetTimeout(){
	## '--timeout' wins, then the per-mode default.
	local value="${timeoutArg}"
	if [[ -z "${value}" ]] && ((doRoot)); then
		value="$(fGetLastCmdlineArg rd.tkz.zfs_import_timeout)"
		[[ "${value}" =~ ^[0-9]+$ ]]  ||  value=60
	fi
	if [[ -z "${value}" ]] && [[ -f "${POOLS_CONF}" ]]; then
		local IMPORT_TIMEOUT=""
		# shellcheck source=/dev/null
		source "${POOLS_CONF}"
		value="${IMPORT_TIMEOUT}"
	fi
	[[ "${value}" =~ ^[0-9]+$ ]]  ||  value=30
	echo "${value}"
}


##•••••••••••••••••••••••••••••••••••••••••••••••••••••••••••••••••••••••••••••
##	Actions.
##•••••••••••••••••••••••••••••••••••••••••••••••••••••••••••••••••••••••••••••

function fIsImported(){ zpool list -H -o name "${1}" &>/dev/null; }


function fClearCache(){
	## Never fails the caller: a leftover cache file is worth a log line, not a failed boot.
	local nextPool=""
	for nextPool in $(zpool list -H -o name 2>/dev/null || true); do
		if [[ "$(zpool get -H -o value cachefile "${nextPool}" 2>/dev/null || true)" != "none" ]]; then
			fLog "Setting cachefile=none on '${nextPool}'."
			zpool set cachefile=none "${nextPool}" 2>&1  ||  fLog "WARNING: couldn't set cachefile=none on '${nextPool}'."
		fi
	done
	if [[ -e "${CACHE_FILE}" ]]; then
		fLog "Deleting '${CACHE_FILE}'."
		rm -f "${CACHE_FILE}" 2>&1  ||  fLog "WARNING: couldn't delete '${CACHE_FILE}'."
	fi
	return 0
}


function fActivateLVs(){
	## The stock initrd import waits for cryptsetup and udev, not for LVM, so it can scan before the LV exists.
	[[ "${#lvmVolumes[@]}" -gt 0 ]]  ||  return 0
	command -v lvm &>/dev/null       ||  return 0
	local nextLV=""
	for nextLV in "${lvmVolumes[@]}"; do
		lvm lvchange -ay "${nextLV}" &>/dev/null  ||  true
	done
	return 0
}


function fTryImport(){
	## One attempt at one pool. Without '-f' first, so the log shows when force was needed, and why.
	local -r poolName="${1}"
	local    errOut=""

	errOut="$(zpool import -N -o cachefile=none "${poolName}" 2>&1)"  &&  { fLog "Imported '${poolName}'."; return 0; }
	fIsImported "${poolName}"  &&  return 0

	## 'no such pool' means the devices aren't there yet. Forcing won't help; just wait and retry.
	if [[ "${errOut,,}" == *"no such pool"* ]]; then
		lastError="${errOut}"
		return 1
	fi

	if zpool import -N -f -o cachefile=none "${poolName}" &>/dev/null; then
		fLog "Imported '${poolName}' with -f. Without it, zpool said:"
		fLog "    $(fOneLine "${errOut}")"
		return 0
	fi
	lastError="${errOut}"
	return 1
}


function fShowDiagnostics(){
	fLog "Pools zpool can see (zpool import):"
	zpool import 2>&1 | fIndent  ||  true
	fLog "Device mapper (/dev/mapper):"
	ls -1 /dev/mapper 2>&1 | fIndent  ||  true
	if command -v lvm &>/dev/null; then
		fLog "Logical volumes (lvm lvs):"
		lvm lvs 2>&1 | fIndent  ||  true
	fi
	return 0
}


function fImportPools(){
	## Retries every pool not yet imported until all are, or the timeout runs out.
	local -ri timeoutSec="${1}" ; shift
	local -a  pending=("$@")
	local -a  stillPending=()
	local -i  attempt=0
	local -ri deadline=$((SECONDS + timeoutSec))
	local     nextPool=""
	local     lastError=""

	[[ -d /sys/module/zfs ]]  ||  modprobe zfs 2>&1  ||  fLog "WARNING: 'modprobe zfs' failed."
	fActivateLVs

	while :; do
		attempt=$((attempt + 1))
		stillPending=()
		for nextPool in "${pending[@]}"; do
			fIsImported "${nextPool}"  &&  continue
			fTryImport  "${nextPool}"  ||  stillPending+=("${nextPool}")
		done
		[[ "${#stillPending[@]}" -eq 0 ]]  &&  return 0
		pending=("${stillPending[@]}")

		((attempt == 1))  &&  fLog "Not imported yet: ${pending[*]}. Retrying every ${RETRY_INTERVAL}s for up to ${timeoutSec}s."
		((SECONDS >= deadline))  &&  break

		sleep "${RETRY_INTERVAL}"
		udevadm settle --timeout=5 &>/dev/null  ||  true
		fActivateLVs
	done

	fLog "FAILED after ${attempt} tries over ${timeoutSec}s. Not imported: ${pending[*]}"
	[[ -n "${lastError}" ]]  &&  fLog "Last error: $(fOneLine "${lastError}")"
	fShowDiagnostics
	return 1
}


function fMain(){
	fParseArgs "$@"

	local -a pools=()
	local    nextPool=""

	fLogBegin
	((doClearCache))  &&  fClearCache

	if ((doRoot)); then
		nextPool="$(fGetRootPool)"
		if [[ -n "${nextPool}" ]]; then
			pools+=("${nextPool}")
			readarray -t lvmVolumes < <(fGetCmdlineArgs rd.lvm.lv)
		else
			fLog "No 'root=ZFS=<pool>/...' on the kernel command line, so no root pool to import."
		fi
	fi
	((doDeclared))  &&  readarray -t -O "${#pools[@]}" pools < <(fGetDeclaredPools)
	pools+=("${argPools[@]}")

	local -i exitCode=0
	if [[ "${#pools[@]}" -gt 0 ]]; then
		fImportPools "$(fGetTimeout)" "${pools[@]}"  ||  exitCode=1
	fi

	fLogEnd
	return "${exitCode}"
}


fInsureRoot "$@"
fMain "$@"




