#!/bin/bash
#  shellcheck disable=2155  ## Disable check to 'Declare and assign separately to avoid masking return values'.

##	Purpose:
##		- Logout-side counterpart of 'tkz_zfs-crypthome_login', run by a systemd timer and a PAM hook:
##		  For every user who has an encrypted ZFS home (marked by the '<custProp_UserName>' ZFS property),
##		  if that user is fully logged out but their datasets are still mounted (or their key still loaded):
##			1. Terminate whatever session remnants/processes still hold files open under their home.
##			2. Unmount their entire dataset tree, escalating gently: systemd mount units (parent first -
##			   see fTryUnmountViaSystemd() for why that order) → plain unmount (children first) →
##			   recursive 'umount -R' (clears foreign mounts nested in the tree - see
##			   fTryUmountRecursive()) → SIGTERM + retry → SIGKILL + forced unmount → lazy unmount
##			   as a last resort.
##			3. Unload the ZFS encryption key, so the data is actually at rest.
##	Instructions:
##		- Deploy the two units from this repo's 'filesystem/debian_13/etc/systemd/system/':
##			tkz-zfs-crypthome-logout-watchdog.service and .timer
##		  then: systemctl daemon-reload && systemctl enable --now tkz-zfs-crypthome-logout-watchdog.timer
##		  The timer runs this every 5 minutes as the backstop.
##		- For an immediate lock at logout, add to /etc/pam.d/common-session, after the pam_systemd.so line:
##			session optional pam_exec.so quiet type=close_session /usr/bin/systemctl start --no-block tkz-zfs-crypthome-logout-watchdog.service
##		  The repo's 'etc/pam.d/common-session' shows the pam_succeed_if line that keeps cron and sudo
##		  (which open and close PAM sessions constantly) from triggering it. Copy the lines, not the file.
##		- Manual run (auto-elevates via sudo): tkz_zfs-crypthome_logout-watchdog [--dry-run]
##	Notes:
##		- Single-instance: holds an flock on a /dev/shm lock file. A second invocation exits immediately.
##		  Locks self-clear when the holder dies (flock semantics), and /dev/shm is wiped on reboot, so a
##		  stale lock can never wedge this permanently.
##		- Logged-in detection uses 'loginctl' (systemd-logind), NOT 'who'/'users': utmp misses GUI sessions
##		  on this setup, which is one of the ways the previous version misbehaved.
##		- Users with linger enabled ('loginctl enable-linger') are treated as "in use" and skipped, since
##		  linger is an explicit request to keep that user's services running while logged out.
##		- Everything is logged to '${logFile}' (see below), plus summaries to syslog:
##			journalctl -t tkz_zfs-crypthome_logout-watchdog
##		  In --unattended mode a pass that found nothing to do writes nothing; at every 5 minutes the
##		  log would otherwise be all noise. The unit's own journal entries still show that it ran.
##	Copyright and license ...: Toward bottom of this file.
##	History .................: At bottom of this file.

##	Copyright © 2026 Jim Collier (ID: 1cv◂‡Vᛦ)
##	Licensed under The GNU General Public License v2.0 or later.
##		https://spdx.org/licenses/GPL-2.0-or-later.html
##	SPDX-License-Identifier: GPL-2.0-or-later


set -euo pipefail

declare -r meName="$(basename "${0}")"
declare -r lockFile="/dev/shm/${meName}.lock"
declare -r logFile="/var/log/${meName}.log"
declare -ri logRotateAtBytes=524288  ## Rotate to .1 at ~512KB; two files max, so logs can never grow unbounded.

## User-defined ZFS property that marks a dataset as some user's encrypted home:
declare -r custProp_UserName="x9.custom.automount:user"
declare -r custProp_Mountpoint="x9.custom.automount:dir"  ## Only consulted when 'mountpoint' is 'legacy'.


function fLog(){
	echo -e "$*"
}

function fSyslog(){
	## For the handful of messages that should be findable via journalctl, not just the log file.
	command -v logger &>/dev/null  &&  logger -t "${meName}" -- "$*" || true
}


function fGetZfsProp(){
	## Echoes the value of ZFS property $2 for dataset $1, or nothing on error.
	zfs get -H -o value "${2}" "${1}" 2>/dev/null || true
}


function fGetMountpointFor(){
	## Echoes the effective mountpoint for dataset $1; 'mountpoint' property, with fallbacks for 'legacy'.
	local -r zfsDataset="$1"
	local mountLocation="$(fGetZfsProp "${zfsDataset}" mountpoint)"
	if [[ "${mountLocation,,}" == "legacy" ]]; then
		mountLocation="$(fGetZfsProp "${zfsDataset}" "${custProp_Mountpoint}")"
		[[ -z "${mountLocation}" ]]  &&  mountLocation="$(findmnt -n -o TARGET --source "${zfsDataset}" 2>/dev/null | head -n 1 || true)"
	fi
	case "${mountLocation}" in
		"-"|"none") mountLocation="" ;;
	esac
	echo "${mountLocation}"
}


function fIsUserInUse(){
	## Returns 0 (in use - do not touch) if the user has any live logind presence, else 1.
	local -r userName="$1"
	local -r state="$(loginctl show-user "${userName}" --property=State --value 2>/dev/null || true)"
	case "${state}" in
		"active"|"online"|"opening")
			fLog "•  loginctl reports user '${userName}' State=${state}."
			return 0
		;;
		"lingering")
			fLog "•  User '${userName}' has linger enabled (State=lingering); leaving their services alone."
			return 0
		;;
	esac
	## Belt-and-braces; utmp can't see GUI sessions here, but if it DOES claim a login, believe it.
	if who | awk '{print $1}' | grep -qx "${userName}" 2>/dev/null; then
		fLog "•  'who' reports user '${userName}' as logged in."
		return 0
	fi
	return 1
}


function fListMountedInTree(){
	## Echoes the mounted datasets in the tree rooted at $1, DEEPEST FIRST (safe direct-unmount order).
	local -r rootDataset="$1"
	zfs list -r -H -t filesystem -o name,mounted "${rootDataset}" 2>/dev/null | awk -F'\t' '$2=="yes" {print $1}' | tac || true
}


function fTryUnmountViaSystemd(){
	## Preferred first unmount rung: ask systemd (PID 1) to stop each mount unit, PARENT FIRST,
	## repeating passes as long as each pass unmounts something. Counter-intuitive but field-proven
	## on this setup: iterating general → specific is the order that works, where classic
	## deepest-first umount escalation tends to wedge. Empirically (verified 2026-08-12 on this
	## exact systemd), 'systemctl stop' on a parent .mount does NOT cascade to its transient child
	## mounts - the parent's stop just fails 'target is busy' while children remain - BUT every pass
	## reliably peels off the deepest still-mounted layer, so a few passes unwind the whole subtree.
	## A "Job failed" line per still-covered parent per pass is therefore normal, not an error.
	local -r rootDataset="$1"
	local -i beforeCount=0  afterCount=0
	local nextDataset=""  nextMountLocation=""  mountUnit=""
	while :; do
		beforeCount="$(fListMountedInTree "${rootDataset}" | grep -c . || true)"
		[[ "${beforeCount}" -eq 0 ]]  &&  return 0
		## Parent-first == the natural hierarchy order of 'zfs list -r' (no 'tac').
		while read -r nextDataset; do
			[[ -z "${nextDataset}" ]]  &&  continue
			nextMountLocation="$(fGetMountpointFor "${nextDataset}")"
			[[ -z "${nextMountLocation}" ]]  &&  continue
			mountUnit="$(systemd-escape -p --suffix=mount "${nextMountLocation}" 2>/dev/null || true)"
			[[ -z "${mountUnit}" ]]  &&  continue
			fLog "•  Executing: systemctl stop '${mountUnit}'"
			systemctl stop "${mountUnit}" 2>&1  ||  true
		done < <(zfs list -r -H -t filesystem -o name,mounted "${rootDataset}" 2>/dev/null | awk -F'\t' '$2=="yes" {print $1}' || true)
		afterCount="$(fListMountedInTree "${rootDataset}" | grep -c . || true)"
		## No progress this pass (something is genuinely holding files) → let the next rung escalate.
		[[ "${afterCount}" -ge "${beforeCount}" ]]  &&  return 0
	done
}


function fTryUnmountAll(){
	## One unmount pass over whatever is still mounted under $1, deepest first. $2: "" or "-f".
	local -r rootDataset="$1"
	local -r forceFlag="${2:-}"
	local nextDataset=""
	while read -r nextDataset; do
		[[ -z "${nextDataset}" ]]  &&  continue
		if [[ -n "${forceFlag}" ]]; then
			fLog "•  Executing: zfs unmount -f '${nextDataset}'"
			zfs unmount -f "${nextDataset}" 2>&1  ||  true
		else
			fLog "•  Executing: zfs unmount '${nextDataset}'"
			zfs unmount "${nextDataset}" 2>&1  ||  true
		fi
	done < <(fListMountedInTree "${rootDataset}")
}


function fTryUmountRecursive(){
	## One pass of util-linux 'umount -R' (then '-f -R') over still-mounted MOUNTPOINTS, deepest
	## first. This is the only rung that can clear a FOREIGN mount (bind, FUSE, AppImage, etc.)
	## nested inside the tree: such a mount makes its parent dataset EBUSY with no process holding
	## anything, so neither 'zfs unmount' (ZFS-only) nor process-killing can ever fix it.
	## ('-f' is nearly a no-op for local filesystems, but costs nothing once plain '-R' has failed.)
	local -r rootDataset="$1"
	local nextDataset=""  nextMountLocation=""
	while read -r nextDataset; do
		[[ -z "${nextDataset}" ]]  &&  continue
		nextMountLocation="$(fGetMountpointFor "${nextDataset}")"
		[[ -z "${nextMountLocation}" ]]  &&  continue
		mountpoint -q "${nextMountLocation}" 2>/dev/null  ||  continue
		fLog "•  Executing: umount -R '${nextMountLocation}'"
		umount -R "${nextMountLocation}" 2>&1  ||  true
		if mountpoint -q "${nextMountLocation}" 2>/dev/null; then
			fLog "•  Executing: umount -f -R '${nextMountLocation}'"
			umount -f -R "${nextMountLocation}" 2>&1  ||  true
		fi
	done < <(fListMountedInTree "${rootDataset}")
}


function fProcessUser(){
	## Evaluates one user+dataset pair, and if the user is logged out, unmounts and locks their home.
	## Returns non-zero only on actual failure to unmount/lock.
	local -r userName="$1"
	local -r rootDataset="$2"

	fLog "\n\n[ Checking user '${userName}', ZFS dataset '${rootDataset}' ... ]"
	fLog "-------------------------------------------------------------------------------"

	if ! getent passwd "${userName}" &>/dev/null; then
		fLog "⚠️  FYI: '${custProp_UserName}=${userName}' on '${rootDataset}', but no such user account exists. Skipping."
		isNoteworthy=1
		return 0
	fi

	## Never pull the rug out from under whoever is running this.
	local -r invokerName="${SUDO_USER:-$(logname 2>/dev/null || true)}"
	if [[ -n "${invokerName}" && "${userName}" == "${invokerName}" ]]; then
		fLog "•  User '${userName}' is the one running this script. Skipping on principle."
		return 0
	fi

	if fIsUserInUse "${userName}"; then
		fLog "✔️ User '${userName}' is logged in (or lingering); leaving everything alone."
		return 0
	fi
	fLog "✔️ User '${userName}' is logged out."

	## What is there to do?
	local -a mountedDatasets=()
	readarray -t mountedDatasets < <(fListMountedInTree "${rootDataset}")
	local encryptionRoot="$(fGetZfsProp "${rootDataset}" encryptionroot)"
	[[ "${encryptionRoot}" == "-" ]]  &&  encryptionRoot=""
	local keyStatus=""
	[[ -n "${encryptionRoot}" ]]  &&  keyStatus="$(fGetZfsProp "${encryptionRoot}" keystatus)"

	if [[ "${#mountedDatasets[@]}" -eq 0 && "${keyStatus}" != "available" ]]; then
		fLog "✔️ Nothing to do: no datasets mounted under '${rootDataset}', and key is not loaded."
		return 0
	fi
	isNoteworthy=1
	fLog "•  Mounted datasets (${#mountedDatasets[@]}): ${mountedDatasets[*]:-none}"
	[[ -n "${encryptionRoot}" ]]  &&  fLog "•  Key status of '${encryptionRoot}': ${keyStatus}"

	if ((isDryRun)); then
		fLog "🔎 DRY RUN: would terminate '${userName}'s leftover processes, unmount the above, and unload the key."
		return 0
	fi

	## Clean up logind session remnants first; this alone often releases everything.
	fLog "•  Executing: loginctl terminate-user '${userName}'"
	loginctl terminate-user "${userName}" 2>/dev/null  ||  true
	sleep 1

	## Escalation ladder. After each rung, stop as soon as nothing in the tree is still mounted.
	## Rung 1: systemd mount units, parent first (see fTryUnmountViaSystemd for why that order).
	fTryUnmountViaSystemd "${rootDataset}"

	local nextMountLocation=""
	local nextDataset=""
	if [[ -n "$(fListMountedInTree "${rootDataset}")" ]]; then
		fLog "•  Still mounted after systemd pass; trying direct 'zfs unmount', deepest first ..."
		fTryUnmountAll "${rootDataset}"
	fi

	## Last non-destructive rung before touching processes; see fTryUmountRecursive() for why.
	if [[ -n "$(fListMountedInTree "${rootDataset}")" ]]; then
		fLog "•  Still mounted; trying recursive 'umount -R' on the mountpoints, deepest first ..."
		fTryUmountRecursive "${rootDataset}"
	fi

	if [[ -n "$(fListMountedInTree "${rootDataset}")" ]]; then
		fLog "•  Still mounted; sending SIGTERM to '${userName}'s processes and to holders of these filesystems ..."
		pkill -15 -u "${userName}" 2>/dev/null  ||  true
		while read -r nextDataset; do
			[[ -z "${nextDataset}" ]]  &&  continue
			nextMountLocation="$(fGetMountpointFor "${nextDataset}")"
			[[ -z "${nextMountLocation}" ]]  &&  continue
			fLog "•  Executing: fuser -k -15 -M -m '${nextMountLocation}'"
			fuser -k -15 -M -m "${nextMountLocation}" 2>&1  ||  true
		done < <(fListMountedInTree "${rootDataset}")
		sleep 3
		fTryUnmountAll "${rootDataset}"
	fi

	if [[ -n "$(fListMountedInTree "${rootDataset}")" ]]; then
		fLog "•  STILL mounted; sending SIGKILL and force-unmounting ..."
		pkill -9 -u "${userName}" 2>/dev/null  ||  true
		while read -r nextDataset; do
			[[ -z "${nextDataset}" ]]  &&  continue
			nextMountLocation="$(fGetMountpointFor "${nextDataset}")"
			[[ -z "${nextMountLocation}" ]]  &&  continue
			fLog "•  Executing: fuser -k -9 -M -m '${nextMountLocation}'"
			fuser -k -9 -M -m "${nextMountLocation}" 2>&1  ||  true
		done < <(fListMountedInTree "${rootDataset}")
		sleep 2
		fTryUnmountAll "${rootDataset}" "-f"
	fi

	if [[ -n "$(fListMountedInTree "${rootDataset}")" ]]; then
		fLog "•  STILL mounted after force; lazy-unmounting as a last resort (holders keep zombie handles until they exit) ..."
		while read -r nextDataset; do
			[[ -z "${nextDataset}" ]]  &&  continue
			nextMountLocation="$(fGetMountpointFor "${nextDataset}")"
			[[ -z "${nextMountLocation}" ]]  &&  continue
			fLog "•  Executing: umount --lazy '${nextMountLocation}'"
			umount --lazy "${nextMountLocation}" 2>&1  ||  true
		done < <(fListMountedInTree "${rootDataset}")
		sleep 1
	fi

	## Verdict on unmounting.
	local -a stillMounted=()
	readarray -t stillMounted < <(fListMountedInTree "${rootDataset}")
	if [[ "${#stillMounted[@]}" -gt 0 ]]; then
		fLog "❌ FAILURE: still mounted for logged-out user '${userName}': ${stillMounted[*]}"
		fSyslog "FAILURE: could not unmount for logged-out user '${userName}': ${stillMounted[*]}"
		return 1
	fi
	fLog "✔️ All of '${userName}'s datasets are unmounted."

	## Unload the key so the data is actually locked.
	if [[ -n "${encryptionRoot}" && "$(fGetZfsProp "${encryptionRoot}" keystatus)" == "available" ]]; then
		fLog "•  Executing: zfs unload-key '${encryptionRoot}'"
		zfs unload-key "${encryptionRoot}" 2>&1  ||  true
		if [[ "$(fGetZfsProp "${encryptionRoot}" keystatus)" != "unavailable" ]]; then
			fLog "❌ FAILURE: key for '${encryptionRoot}' is still loaded after 'zfs unload-key'."
			fSyslog "FAILURE: key for '${encryptionRoot}' (user '${userName}') is still loaded after unmount."
			return 1
		fi
		fLog "✔️ Key for '${encryptionRoot}' is unloaded."
	fi

	fLog "✔️ SUCCESS: '${userName}'s encrypted home is unmounted and locked."
	fSyslog "SUCCESS: unmounted and locked '${userName}'s encrypted home ('${rootDataset}')."
	return 0
}


function fMain(){

	## Runs from systemd with a minimal environment; make sure the basics are in PATH.
	export PATH="${PATH}:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
	cd /  ## So this process itself can never be a mountpoint holder.

	## Args
	local nextArg=""
	for nextArg in "$@"; do
		case "${nextArg,,}" in
			"--unattended"|"--cron") isUnattended=1 ;;  ## '--cron' is the old spelling.
			"--dry-run")             isDryRun=1 ;;
			*) echo -e "\nUsage: ${meName} [--unattended] [--dry-run]\n\t--unattended : No stdout; log to '${logFile}' only when something happened. Used by the systemd unit.\n\t--dry-run .. : Report what would be done, change nothing.\n" >&2; return 1 ;;
		esac
	done

	## Must be root; auto-elevate for convenience on manual runs.
	if [[ "${EUID}" -ne 0 ]]; then
		exec sudo "$0" "$@"
	fi

	## Single instance: bail immediately (successfully) if another instance holds the lock.
	## flock releases on process death and /dev/shm clears on reboot, so stale locks are impossible.
	exec {lockFd}>"${lockFile}"
	if ! flock -n "${lockFd}"; then
		echo "FYI: Another instance of ${meName} is already running (lock: '${lockFile}'). Exiting."
		fSyslog "FYI: Another instance is already running; exiting."
		return 0
	fi

	## Logging. Interactive: stdout plus ${logFile} (self-rotating). Unattended: buffer the pass, and
	## keep it only if something happened or the run failed (see the flush after fMain).
	if [[ -f "${logFile}" && "$(stat -c %s "${logFile}" 2>/dev/null || echo 0)" -gt "${logRotateAtBytes}" ]]; then
		mv -f "${logFile}" "${logFile}.1"
	fi
	if ((isUnattended)); then
		logBuffer="$(mktemp "/dev/shm/${meName}.XXXXXX")"
		exec >>"${logBuffer}" 2>&1
	else
		exec > >(tee -a "${logFile}") 2>&1
	fi

	fLog "\n\n==============================================================================="
	fLog "[ ${meName} started $(date "+%Y%m%d-%H%M%S")$( ((isDryRun)) && echo ' (DRY RUN)' || true ) ]"

	## Fail loudly if a hard dependency is missing.
	local dep=""
	for dep in awk findmnt flock fuser getent loginctl mountpoint pkill stat systemctl systemd-escape tac umount who zfs; do
		if ! command -v "${dep}" &>/dev/null; then
			fLog "❌ ERROR in ${meName}.${FUNCNAME[0]}(): Dependency not installed: '${dep}'."
			fSyslog "ERROR: dependency not installed: '${dep}'."
			return 1
		fi
	done

	## Discover users with encrypted ZFS homes: every filesystem with ${custProp_UserName} locally set.
	## Lexical sort guarantees parents come before their children, so the first dataset seen for a user
	## is their top-level home dataset; deeper ones with the same (inheritable-looking) local prop are skipped.
	local -A rootDatasetForUser=()
	local nextDataset=""  nextUserName=""
	while IFS=$'\t' read -r nextDataset nextUserName; do
		[[ -z "${nextDataset}" || -z "${nextUserName}" ]]  &&  continue
		if [[ "${nextUserName}" == "root" ]]; then
			fLog "⚠️  FYI: refusing on principle to ever watchdog user 'root' ('${nextDataset}'). Skipping."
			isNoteworthy=1
			continue
		fi
		if [[ -v "rootDatasetForUser[${nextUserName}]" ]]; then
			if [[ "${nextDataset}" == "${rootDatasetForUser[${nextUserName}]}"/* ]]; then
				continue  ## Child of the already-recorded top-level dataset.
			fi
			fLog "⚠️  FYI: user '${nextUserName}' has multiple unrelated datasets marked ('${rootDatasetForUser[${nextUserName}]}' and '${nextDataset}'); only handling the first."
			isNoteworthy=1
			continue
		fi
		rootDatasetForUser["${nextUserName}"]="${nextDataset}"
	done < <(zfs get -H -t filesystem -s local -o name,value "${custProp_UserName}" 2>/dev/null | LC_ALL=C sort || true)

	if [[ "${#rootDatasetForUser[@]}" -eq 0 ]]; then
		fLog "FYI: No ZFS filesystems found with a local '${custProp_UserName}' property; nothing to watchdog."
		fLog "[ Done. ]"
		return 0
	fi

	## Process each user; one user's failure doesn't stop the others.
	local -i errorCount=0
	for nextUserName in "${!rootDatasetForUser[@]}"; do
		fProcessUser "${nextUserName}" "${rootDatasetForUser[${nextUserName}]}"  ||  errorCount+=1
	done

	fLog "\n[ Done. Users checked: ${#rootDatasetForUser[@]}; failures: ${errorCount}. ]\n"
	[[ "${errorCount}" -gt 0 ]]  &&  return 1
	return 0

}


## File-scope flags (set in fMain's arg parsing; declared here so all functions can see them).
declare -i isUnattended=0
declare -i isDryRun=0
declare -i isNoteworthy=0  ## Unattended passes reach the log file only when set, or when the run failed.
declare    logBuffer=""

declare -i exitCode=0
fMain "$@"  ||  exitCode=$?
if [[ -n "${logBuffer}" ]]; then
	if (( isNoteworthy || exitCode )); then
		cat "${logBuffer}" >> "${logFile}"  ||  true
	fi
	rm -f "${logBuffer}"
fi
exit "${exitCode}"


##	History:
##		- 20201219: Created.
##		- 20201220: Bug fixes and enhancements.
##		- 20230112: Minor improvements, big improvements to functionality.
##		- 20230113:
##			- Added more information output via fuser and lsof.
##			- Try gently killing only write processes first.
##			- Try harder to unmount after killing stuff.
##			- Initial list for loop now limited to 1) ZFS datasets, AND 2) that are mounted, AND 3) that are mounted under "/home".
##			- Significantly improved error and conditions checking.
##			- Abort if being run by current user.
##			- Added user-friendly text string arg to fEchoAndDo().
##		- 20260812: Full rewrite; the old version was a no-op on current systems.
##			- Datasets are now discovered via the same '${custProp_UserName}' ZFS property the login script
##			  uses - NOT by grepping 'mount' output for a hardcoded 'rpool/(USERDATA|homez)' pool layout
##			  (which no longer matched anything, so the old script always exited at its first check).
##			- Logged-in detection now uses 'loginctl' instead of 'users'/utmp, which misses GUI sessions.
##			- Designed for /etc/cron.d (hourly); companion cron file added to the repo. The old
##			  self-fork/disown re-entrancy scheme is gone.
##			- Single-instance enforcement via flock on /dev/shm (self-clearing; wiped on reboot).
##			- Cleanly escalates: loginctl terminate-user → systemd mount-unit stop (parent-first
##			  passes, repeated while progress is made - see fTryUnmountViaSystemd()) → direct
##			  unmount → recursive 'umount -R' (the only rung that clears foreign mounts nested in
##			  the tree - see fTryUmountRecursive()) → SIGTERM+retry → SIGKILL+force → lazy unmount;
##			  direct rungs go children-before-parents; then 'zfs unload-key', verified.
##			- Unloads the encryption key (the old version tried, but usually after failing to unmount).
##			- Skips: logged-in users, lingering users, the invoking user, root, nonexistent accounts.
##			- Fixed bugs: 'fuser/lsof \"\$1\"' on an empty arg; PATH missing a ':'; '[[ lastExitCode -ne 0 ]]'
##			  testing a literal string; username derived by grepping all of /etc/passwd for a substring.
##			- Self-rotating log at '/var/log/<name>.log' (+ .1), plus summaries to syslog.
##			- Added --dry-run mode; 'set -euo pipefail' throughout.
##		- 20260907: Runs from a systemd timer every 5 minutes plus a PAM close_session hook, not hourly cron.
##			- '--cron' renamed '--unattended' (old spelling still accepted). Unattended passes that found
##			  nothing to do no longer write to the log file.
##			- The unit's start timeout kills a wedged run, whole cgroup, so the flock can never block later
##			  runs. Companion cron file removed from the repo.
