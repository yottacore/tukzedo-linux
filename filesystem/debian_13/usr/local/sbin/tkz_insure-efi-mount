#!/bin/bash
#  shellcheck disable=2155  ## Disable check to 'Declare and assign separately to avoid masking return values'.
#  shellcheck disable=2120  ## 'References arguments, but none are ever passed.' Valid function argument overloading.

##	Purpose:
##		- Makes sure the EFI system partition is mounted and readable at its mountpoint
##		  (default '/boot/efi'), and repairs it if not.
##		- With ZFS root and a separate '/boot' holding the ESP, a later mount over '/boot' can hide the
##		  mounted '/boot/efi'. It then looks empty, and 'tkz_rebuild-uki' writes UKIs into the wrong
##		  filesystem. The fix is to unmount the hidden mount, then mount it again.
##	Syntax:
##		tkz_insure-efi-mount  [mountpoint]  [options]
##	Options:
##		    --check ..........: Report the state and exit; never change anything. Exit code still reflects
##		                        whether the mountpoint is healthy, so it works as a monitoring probe.
##		    --dry-run ........: Say what would be done, but don't do it.
##		    --wait <seconds> .: Poll for up to this long for the mountpoint to become healthy on its own
##		                        before intervening. Useful when racing an async mount; 0 = don't wait.
##		-h, --help ...........: This.
##	Exit codes:
##		0 = mountpoint is healthy (either already, or after a successful repair).
##		1 = mountpoint is unhealthy and could not be safely repaired; the reason is logged.
##		2 = usage error.
##	Notes:
##		- Runs as root. If invoked as a normal user it re-executes itself via sudo.
##		- Starts the systemd mount unit, so systemd's view of the mount stays right, and falls back to plain
##		  'mount' if that fails or the unit is masked. A masked unit never mounts at boot, so unmask it.
##		- Won't act when the unmounted mountpoint has files in it. Mounting over them would hide them, so
##		  that's left to sort out by hand.
##		- Normally invoked by 'tkz-insure-efi-mount.service' (in this repo under
##		  'filesystem/debian_13/etc/systemd/system/'). Progress is logged to the journal both as unit
##		  output and as structured 'tkz_startup-log' records:
##			journalctl -b -u tkz-insure-efi-mount.service
##			tkz_show-startup-log
##	Copyright and license ...: Toward bottom of this file.
##	History .................: At bottom of this file.

##	Copyright © 2026 Jim Collier [ID: 2უNაɘ«҂թȹɤξπ๙¿ձϖ]
##	Licensed under The GNU General Public License v2.0 or later.
##		https://spdx.org/licenses/GPL-2.0-or-later.html
##	SPDX-License-Identifier: GPL-2.0-or-later


set -euo pipefail

declare -r meName="$(basename "${0}")"
declare -r mePath="$(readlink -f "${0}")"
declare -r startupLogger="/usr/local/sbin/tkz_startup-log"

## Options
declare    mountPoint="/boot/efi"
declare -i isCheckOnly=0
declare -i isDryRun=0
declare -i waitSeconds=0

## Derived at startup by fInit().
declare    mountUnitName=""
declare    parentDir=""


function fLog(){
	echo "[ ${meName}: $* ]"
	[[ -x "${startupLogger}" ]]  &&  "${startupLogger}" "${mePath}" note "$*"  ||  true
}

function fLogBegin(){ [[ -x "${startupLogger}" ]] && "${startupLogger}" "${mePath}" begin "$*" || true; }
function fLogEnd(){   [[ -x "${startupLogger}" ]] && "${startupLogger}" "${mePath}" end   "$*" || true; }


function fShowSyntax(){
	echo
	sed -n '/^##\tSyntax:/,/^##\tNotes:/p' "${0}" | sed '$d' | sed 's/^##\t\?//; s/^\t/  /'
	echo
}


function fThrowUsageError(){
	echo >&2
	echo "${meName}: $*" >&2
	echo "Try '${meName} --help'." >&2
	echo >&2
	exit 2
}


function fParseArgs(){
	local -i sawMountPoint=0
	while [[ "$#" -gt 0 ]]; do
		case "${1,,}" in
			"--check")        isCheckOnly=1; shift ;;
			"--dry-run")      isDryRun=1;    shift ;;
			"--wait")         [[ "$#" -ge 2 ]] || fThrowUsageError "'--wait' needs a value."
			                  waitSeconds="$2";  shift 2 ;;
			"-h"|"--help")    fShowSyntax; exit 0 ;;
			-*)               fThrowUsageError "Unrecognized option: '$1'." ;;
			*)
				[[ "${sawMountPoint}" -eq 1 ]]  &&  fThrowUsageError "Only one mountpoint may be given."
				mountPoint="$1"; sawMountPoint=1; shift
			;;
		esac
	done

	[[ "${waitSeconds}" =~ ^[0-9]+$ ]]  ||  fThrowUsageError "'--wait' needs a whole number of seconds."

	## Normalize away any trailing slash, so mountpoint comparisons and unit-name escaping stay consistent.
	[[ "${mountPoint}" != "/" ]]  &&  mountPoint="${mountPoint%/}"
	[[ "${mountPoint}" == /* ]]   ||  fThrowUsageError "The mountpoint must be an absolute path: '${mountPoint}'."
}


function fInsureRoot(){
	[[ "${EUID}" -eq 0 ]]  &&  return 0

	## Read-only modes don't need root, and a password prompt just to print help would be annoying.
	local nextArg=""
	for nextArg in "$@"; do
		case "${nextArg,,}" in
			"-h"|"--help"|"-v"|"--version"|"--check"|"--dry-run")  return 0 ;;
		esac
	done

	command -v sudo &>/dev/null  ||  { echo "${meName}: must run as root." >&2; exit 1; }
	echo "[ ${meName}: not root; re-executing via sudo ... ]"
	exec sudo -- "${mePath}" "$@"
}


function fInit(){
	parentDir="$(dirname "${mountPoint}")"
	mountUnitName="$(systemd-escape -p --suffix=mount "${mountPoint}" 2>/dev/null || true)"
}


##•••••••••••••••••••••••••••••••••••••••••••••••••••••••••••••••••••••••••••••
##	State checks.
##•••••••••••••••••••••••••••••••••••••••••••••••••••••••••••••••••••••••••••••

function fIsMounted(){       mountpoint -q "${1}" 2>/dev/null; }
function fDirExists(){       [[ -d "${1}" ]]; }
function fDirHasContents(){  [[ -n "$(ls -1A "${1}" 2>/dev/null || true)" ]]; }

function fIsHealthy(){
	## Healthy: it exists, something is mounted on it, and it isn't empty. An ESP always has an 'EFI'
	## folder, so empty means shadowed or wrong.
	fDirExists      "${mountPoint}"  &&  \
	fIsMounted      "${mountPoint}"  &&  \
	fDirHasContents "${mountPoint}"
}

function fDescribeState(){
	local mountedStr="no"   ; fIsMounted      "${mountPoint}"  &&  mountedStr="yes"
	local existsStr="no"    ; fDirExists      "${mountPoint}"  &&  existsStr="yes"
	local contentsStr="no"  ; fDirHasContents "${mountPoint}"  &&  contentsStr="yes"
	local sourceStr="$(findmnt -n -o SOURCE --target "${mountPoint}" 2>/dev/null | head -n 1 || true)"
	echo "mountpoint '${mountPoint}': exists=${existsStr} mounted=${mountedStr} non-empty=${contentsStr} source='${sourceStr:-none}'"
}


function fWaitForHealthy(){
	## Give a mount that's in progress time to finish.
	local -i remaining="${waitSeconds}"
	[[ "${remaining}" -le 0 ]]  &&  return 1
	fLog "Waiting up to ${remaining}s for '${mountPoint}' to become healthy on its own ..."
	while [[ "${remaining}" -gt 0 ]]; do
		fIsHealthy  &&  return 0
		sleep 1
		remaining=$((remaining - 1))
	done
	return 1
}


##•••••••••••••••••••••••••••••••••••••••••••••••••••••••••••••••••••••••••••••
##	Actions.
##•••••••••••••••••••••••••••••••••••••••••••••••••••••••••••••••••••••••••••••

function fTryUnmount(){
	## Used only for the shadowed case: something is mounted here but reads as empty.
	if [[ "${isDryRun}" -eq 1 ]]; then
		fLog "DRY RUN: would unmount '${mountPoint}'."
		return 0
	fi

	if [[ -n "${mountUnitName}" ]]; then
		fLog "Executing: systemctl stop '${mountUnitName}'"
		systemctl stop "${mountUnitName}" 2>&1  ||  true
		fIsMounted "${mountPoint}"  ||  return 0
	fi

	fLog "Executing: umount -R '${mountPoint}'"
	umount -R "${mountPoint}" 2>&1  ||  true
	fIsMounted "${mountPoint}"  ||  return 0

	## Lazy is OK here, since nothing can reach the shadowed mount anyway.
	fLog "Still mounted; executing: umount -R --lazy '${mountPoint}'"
	umount -R --lazy "${mountPoint}" 2>&1  ||  true
	fIsMounted "${mountPoint}"  &&  return 1
	return 0
}


function fTryMount(){
	if [[ "${isDryRun}" -eq 1 ]]; then
		fLog "DRY RUN: would mount '${mountPoint}'."
		return 0
	fi

	## Let systemd do it, so its view of the mount unit stays right.
	if [[ -n "${mountUnitName}" ]]; then
		local unitLoadState="$(systemctl show "${mountUnitName}" -p LoadState --value 2>/dev/null || true)"
		if [[ "${unitLoadState}" == "masked" ]]; then
			fLog "NOTE: mount unit '${mountUnitName}' is masked, so systemd will never mount this at boot."
			fLog "NOTE: consider 'systemctl unmask ${mountUnitName}' so this repair stops being needed."
		else
			fLog "Executing: systemctl start '${mountUnitName}'"
			systemctl start "${mountUnitName}" 2>&1  ||  true
			fIsHealthy  &&  return 0
		fi
	fi

	## Fallback: mount straight from '/etc/fstab'.
	fLog "Executing: mount '${mountPoint}'"
	mount "${mountPoint}" 2>&1  ||  true
	fIsHealthy  &&  return 0
	return 1
}


function fRepair(){
	## Refuse the cases where acting would make things worse or hide data.
	if ! fDirExists "${mountPoint}"; then
		fLog "REFUSING: '${mountPoint}' does not exist, so there is nothing to mount onto."
		return 1
	fi
	if ! fDirExists "${parentDir}"; then
		fLog "REFUSING: parent directory '${parentDir}' does not exist."
		return 1
	fi
	if ! fDirHasContents "${parentDir}"; then
		fLog "REFUSING: parent directory '${parentDir}' is empty, which usually means it is not mounted yet."
		return 1
	fi
	if ! fIsMounted "${mountPoint}"  &&  fDirHasContents "${mountPoint}"; then
		fLog "REFUSING: '${mountPoint}' is not mounted but already holds files. Mounting over them would"
		fLog "REFUSING: strand that data invisibly. Move those files aside, then re-run."
		return 1
	fi

	## Shadowed: mounted, but reads as empty because a later mount covers it. Detach before remounting.
	if fIsMounted "${mountPoint}"; then
		fLog "'${mountPoint}' is mounted but reads as empty. It looks shadowed by a later mount."
		if ! fTryUnmount; then
			fLog "FAILED: could not unmount the shadowed '${mountPoint}' to remount it."
			return 1
		fi
		fLog "Unmounted the shadowed mount."
	else
		fLog "'${mountPoint}' is not mounted."
	fi

	fTryMount  ||  return 1
	return 0
}


function fMain(){
	fParseArgs "$@"
	fInit

	fLogBegin
	fLog "$(fDescribeState)"

	local -i exitCode=0

	if fIsHealthy; then
		fLog "Nothing to do. '${mountPoint}' is mounted and readable."
	elif fWaitForHealthy; then
		fLog "'${mountPoint}' became healthy on its own while waiting."
	elif [[ "${isCheckOnly}" -eq 1 ]]; then
		fLog "CHECK ONLY: '${mountPoint}' is not healthy. (Re-run without '--check' to attempt a repair.)"
		exitCode=1
	elif fRepair; then
		if [[ "${isDryRun}" -eq 1 ]]; then
			fLog "DRY RUN: nothing was changed, so '${mountPoint}' is still not mounted."
		else
			fLog "Successfully mounted '${mountPoint}'."
			fLog "$(fDescribeState)"
		fi
	else
		fLog "FAILED: '${mountPoint}' is not usable. $(fDescribeState)"
		exitCode=1
	fi

	fLogEnd
	return "${exitCode}"
}


fInsureRoot "$@"
fMain "$@"




