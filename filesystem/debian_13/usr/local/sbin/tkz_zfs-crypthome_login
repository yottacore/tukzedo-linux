#!/bin/bash -p
#  shellcheck disable=2155  ## Disable check to 'Declare and assign separately to avoid masking return values'.

##	The '-p' in the shebang is LOAD-BEARING - do not remove it:
##		When PAM runs this from a setuid-root service (su, and anything else where euid=0 but the real
##		uid is the invoking user), plain bash silently drops euid back to the real uid "for security",
##		after which 'zfs load-key'/'zfs mount' fail with permission errors. '-p' (privileged mode) makes
##		bash keep euid=0. Root-owned services (login, lightdm, sshd, cron) are unaffected either way.

##	Purpose:
##		- Mounts a user's encrypted ZFS home dataset - and ALL of its child datasets - via PAM at login.
##		- If ANY dataset in the user's tree fails to mount, exits non-zero, so that PAM (when configured with
##		  'requisite' as below) refuses the login rather than dropping the user into a broken/empty home.
##		- Anything already sitting inside a not-yet-mounted mountpoint (which would block or shadow the real
##		  contents) is safely moved aside - NEVER deleted - into a '.tkz_premount-quarantine' folder next to
##		  the mountpoint, and mounting then proceeds.
##	Requirements - ZFS properties on the user's top-level home dataset:
##		canmount=noauto
##		x9.custom.automount:user=<username>  ## The username that PAM will pass in $PAM_USER.
##	Instructions:
##		- Edit '/etc/pam.d/common-auth', insert the following after the 'pam_deny.so' line:
##			## ZFS encrypted home
##			auth    requisite                       pam_exec.so expose_authtok quiet  /usr/local/sbin/tkz_zfs-crypthome_login
##		- Notes on the above:
##			- 'requisite' (vs the old 'optional') is what enforces "no login unless ALL datasets mounted".
##			- This only runs AFTER pam_unix has accepted the password, and it runs for every service that
##			  includes common-auth (console login, display manager, screen unlock, sudo). The fast paths
##			  (no matching dataset, or everything already mounted) exit 0 immediately, which is what keeps
##			  root/console logins and sudo safe and quick.
##			- LOCKOUT WARNING: with 'requisite', if this script file is missing or non-executable, pam_exec
##			  fails and ALL password logins fail (root console included; login uses PAM, only sulogin/rescue
##			  does not). Recovery: rescue boot, or a still-open root/sudo session, then either restore this
##			  script or revert '/etc/pam.d/common-auth' from its backup.
##	Manual testing (safe - read-only unless something actually needs mounting):
##		sudo PAM_USER=<username> tkz_zfs-crypthome_login </dev/null
##	  Or interactively (prompts for the password only if the ZFS key actually needs loading):
##		sudo tkz_zfs-crypthome_login <username>
##	Troubleshooting:
##		- PAM invokes this with 'quiet', so stdout is discarded; everything important also goes to syslog:
##			journalctl -t tkz_zfs-crypthome_login
##	Copyright and license ...: Toward bottom of this file.
##	History .................: At bottom of this file.

##	Copyright © 2026 Jim Collier (ID: 1cv◂‡Vᛦ)
##	Licensed under The GNU General Public License v2.0 or later.
##		https://spdx.org/licenses/GPL-2.0-or-later.html
##	SPDX-License-Identifier: GPL-2.0-or-later


set -euo pipefail

declare -r meName="$(basename "${0}")"

## User-defined ZFS properties this script keys off of.
declare -r custProp_UserName="x9.custom.automount:user"
declare -r custProp_Mountpoint="x9.custom.automount:dir"  ## Only consulted when 'mountpoint' is 'legacy'.

## If this file exists, its contents are appended to the password before 'zfs load-key'.
## (Only meaningful if this file itself lives on an encrypted filesystem that is locked when offline.)
declare -r pwdLongSaltFile="/etc/cryptkeys/zfs_pam_longsalt_${HOSTNAME}.txt"

## Where pre-existing mountpoint contents get moved (never deleted): '<parent of mountpoint>/<this>/<mountpoint basename>_<timestamp>/'.
declare -r quarantineDirName=".tkz_premount-quarantine"


function fLog(){
	## Info-level message, to stdout and syslog. (PAM discards stdout due to 'quiet'; syslog is the reliable channel.)
	echo -e "$*"
	command -v logger &>/dev/null  &&  logger -t "${meName}" -- "$*" || true
}

function fLogError(){
	## Error-level message, to stderr and syslog.
	echo -e "❌ $*" >&2
	command -v logger &>/dev/null  &&  logger -p auth.err -t "${meName}" -- "ERROR: $*" || true
}


function fGetZfsProp(){
	## Echoes the value of ZFS property $2 for dataset $1, or nothing on error.
	zfs get -H -o value "${2}" "${1}" 2>/dev/null || true
}


function fGetMountpointFor(){
	## Echoes the effective mountpoint for dataset $1: the 'mountpoint' property, falling back to
	## ${custProp_Mountpoint} for 'legacy'. Echoes nothing if indeterminate.
	local -r zfsDataset="$1"
	local mountLocation="$(fGetZfsProp "${zfsDataset}" mountpoint)"
	if [[ "${mountLocation,,}" == "legacy" ]]; then
		mountLocation="$(fGetZfsProp "${zfsDataset}" "${custProp_Mountpoint}")"
	fi
	case "${mountLocation}" in
		"-"|"none") mountLocation="" ;;
	esac
	echo "${mountLocation}"
}


function fQuarantinePremountContents(){
	## If the (not-yet-mounted) mountpoint dir $1 has anything in it, move it ALL - files, folders, hidden
	## entries - into a timestamped quarantine folder next to the mountpoint. Never deletes anything.
	## Returns non-zero if the mountpoint could not be emptied.
	local -r mountLocation="$1"

	[[ -d "${mountLocation}" ]]  ||  return 0  ## 'zfs mount' will create it.

	local -a entries=()
	readarray -d '' -t entries < <(find "${mountLocation}" -mindepth 1 -maxdepth 1 -print0 2>/dev/null || true)
	[[ "${#entries[@]}" -eq 0 ]]  &&  return 0

	local -r quarantineBase="$(dirname "${mountLocation}")/${quarantineDirName}"
	mkdir -p "${quarantineBase}"
	chmod 700 "${quarantineBase}"
	local -r quarantineDir="$(mktemp -d "${quarantineBase}/$(basename "${mountLocation}")_$(date "+%Y%m%d-%H%M%S")_XXXX")"

	fLog "⚠️  Mountpoint '${mountLocation}' is not empty (${#entries[@]} entries); moving them (NOT deleting) to '${quarantineDir}' ..."
	mv -- "${entries[@]}" "${quarantineDir}/"

	## Verify it is now actually empty.
	if [[ -n "$(find "${mountLocation}" -mindepth 1 -maxdepth 1 -print -quit 2>/dev/null)" ]]; then
		fLogError "In ${meName}.${FUNCNAME[0]}(): '${mountLocation}' is STILL not empty after quarantining its contents."
		return 1
	fi
	fLog "✔️ Quarantined pre-mount contents of '${mountLocation}' to '${quarantineDir}'."
	return 0
}


function fMain(){

	## Since this runs from PAM (and possibly cron/services), append basic paths in case none are set.
	export PATH="${PATH}:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
	cd /

	## Read the password from stdin NOW if it is being piped to us (PAM's 'expose_authtok' does this).
	## If stdin is a terminal (manual run), defer prompting until/unless the key actually needs loading.
	local userPwd=""
	local -i pwdIsFromStdin=0
	if [[ ! -t 0 ]]; then
		userPwd="$(cat -)"
		pwdIsFromStdin=1
	fi

	## Whose home are we mounting? $PAM_USER normally; first arg as a fallback for manual testing.
	local -r targetUser="${PAM_USER:-${1:-}}"
	if [[ -z "${targetUser}" ]]; then
		fLogError "In ${meName}.${FUNCNAME[0]}(): No target user; \$PAM_USER is not set and no username argument was given."
		return 1
	fi

	fLog "[ ${meName} started $(date "+%Y%m%d-%H%M%S") for user '${targetUser}'. ]"

	## Fail loudly (blocking login, if 'requisite') if a hard dependency is missing.
	local dep=""
	for dep in awk date find mktemp mv zfs; do
		if ! command -v "${dep}" &>/dev/null; then
			fLogError "In ${meName}.${FUNCNAME[0]}(): Dependency not installed: '${dep}'."
			return 1
		fi
	done

	## Find every filesystem that has ${custProp_UserName} locally set to this user.
	local -a candidateDatasets=()
	readarray -t candidateDatasets < <(zfs get -H -t filesystem -s local -o name,value "${custProp_UserName}" 2>/dev/null | awk -F'\t' -v u="${targetUser}" '$2==u {print $1}' || true)

	## Of those, keep only ones with canmount=noauto, and pick the top-most (shortest name) as THE home dataset.
	local rootDataset=""
	local nextDataset=""
	for nextDataset in "${candidateDatasets[@]}"; do
		[[ "$(fGetZfsProp "${nextDataset}" canmount)" == "noauto" ]]  ||  continue
		if [[ -z "${rootDataset}" ]] || [[ "${#nextDataset}" -lt "${#rootDataset}" ]]; then
			rootDataset="${nextDataset}"
		fi
	done

	## No matching dataset is NOT an error: most users (e.g. root) simply don't have an encrypted ZFS home.
	## Exiting 0 here is what keeps 'requisite' safe for them.
	if [[ -z "${rootDataset}" ]]; then
		fLog "FYI: User '${targetUser}' has no ZFS filesystem with both '${custProp_UserName}=${targetUser}' [local] and 'canmount=noauto'; nothing for ${meName} to do."
		return 0
	fi
	fLog "✔️ Determined that '${targetUser}'s ZFS home dataset is '${rootDataset}'."

	## Resolve and validate its mountpoint.
	local -r rootMountLocation="$(fGetMountpointFor "${rootDataset}")"
	if [[ -z "${rootMountLocation}" ]]; then
		fLogError "In ${meName}.${FUNCNAME[0]}(): Unable to determine mount location of '${rootDataset}' from ZFS properties 'mountpoint' or '${custProp_Mountpoint}'."
		return 1
	fi
	fLog "✔️ Mount location: '${rootMountLocation}'."

	## Load the encryption key if needed. (Idempotent: skipped when already loaded, e.g. screen unlock, sudo.)
	local -r encryptionRoot="$(fGetZfsProp "${rootDataset}" encryptionroot)"
	if [[ -n "${encryptionRoot}" && "${encryptionRoot}" != "-" ]]; then
		if [[ "$(fGetZfsProp "${encryptionRoot}" keystatus)" == "unavailable" ]]; then

			## Get the password interactively if it wasn't piped in.
			if ((! pwdIsFromStdin)); then
				read -rs -p "Password to unlock '${encryptionRoot}': " userPwd
				echo
			fi
			if [[ -z "${userPwd}" ]]; then
				fLogError "In ${meName}.${FUNCNAME[0]}(): Key for '${encryptionRoot}' is not loaded and no password was provided."
				return 1
			fi

			## Append the long-salt file contents, if that file exists and is non-empty.
			if [[ -f "${pwdLongSaltFile}" ]]; then
				local pwdSalt="$(tr -d '\n' < "${pwdLongSaltFile}" 2>/dev/null || true)"
				[[ -n "${pwdSalt}" ]]  &&  userPwd="${userPwd}_${pwdSalt}"
			fi

			fLog "[ Loading key for '${encryptionRoot}' ... ]"
			printf '%s\n' "${userPwd}" | zfs load-key "${encryptionRoot}" 2>/dev/null  ||  true  ## Trailing \n matters: the old, known-working version piped via '<<<'.
			if [[ "$(fGetZfsProp "${encryptionRoot}" keystatus)" != "available" ]]; then
				fLogError "In ${meName}.${FUNCNAME[0]}(): 'zfs load-key ${encryptionRoot}' did not result in keystatus=available. (Wrong password, or salt file mismatch?)"
				return 1
			fi
			fLog "✔️ Key loaded for '${encryptionRoot}'."
		else
			fLog "✔️ Key for '${encryptionRoot}' is already loaded."
		fi
	fi
	userPwd=""

	## Mount the whole tree, parents first ('zfs list -r' outputs hierarchy order), quarantining any
	## pre-existing mountpoint contents along the way. EVERY dataset must end up mounted (or be canmount=off).
	local -a treeLines=()
	readarray -t treeLines < <(zfs list -r -H -t filesystem -o name,canmount "${rootDataset}")
	local -a failedDatasets=()
	local -i mountedCount=0
	local nextLine=""  nextCanmount=""  nextMountLocation=""
	for nextLine in "${treeLines[@]}"; do
		nextDataset="${nextLine%%$'\t'*}"
		nextCanmount="${nextLine##*$'\t'}"

		if [[ "${nextCanmount}" == "off" ]]; then
			fLog "•  Skipping '${nextDataset}' (canmount=off)."
			continue
		fi

		if [[ "$(fGetZfsProp "${nextDataset}" mounted)" == "yes" ]]; then
			fLog "✔️ Already mounted: '${nextDataset}'."
			mountedCount+=1
			continue
		fi

		## Reads (zfs get/list) work unprivileged, but from here on we need root. Normally guaranteed by
		## the shebang's '-p' (see top); this only trips for unprivileged PAM stacks (e.g. a user-space
		## screen locker) AND something actually needing mounting - in which case failing is correct.
		if [[ "${EUID}" -ne 0 ]]; then
			fLogError "In ${meName}.${FUNCNAME[0]}(): '${nextDataset}' needs mounting but this process has euid=${EUID} (not root), so it cannot. (If this happened via su/sudo, check that the shebang still says '#!/bin/bash -p'.)"
			failedDatasets+=("${nextDataset}")
			continue
		fi

		nextMountLocation="$(fGetMountpointFor "${nextDataset}")"
		if [[ -z "${nextMountLocation}" ]]; then
			fLogError "Cannot determine mountpoint for '${nextDataset}'."
			failedDatasets+=("${nextDataset}")
			continue
		fi

		if ! fQuarantinePremountContents "${nextMountLocation}"; then
			failedDatasets+=("${nextDataset}")
			continue
		fi

		fLog "[ Mounting '${nextDataset}' at '${nextMountLocation}' ... ]"
		zfs mount "${nextDataset}"  ||  true
		if [[ "$(fGetZfsProp "${nextDataset}" mounted)" == "yes" ]]; then
			fLog "✔️ Mounted '${nextDataset}'."
			mountedCount+=1
		else
			fLogError "Failed to mount '${nextDataset}' at '${nextMountLocation}'."
			failedDatasets+=("${nextDataset}")
		fi
	done

	## THE gate: every dataset in the user's tree must have mounted, or the login is refused.
	if [[ "${#failedDatasets[@]}" -gt 0 ]]; then
		fLogError "In ${meName}.${FUNCNAME[0]}(): ${#failedDatasets[@]} of '${targetUser}'s dataset(s) failed to mount: ${failedDatasets[*]}. Refusing login."
		return 1
	fi

	## Belt-and-braces: the home mountpoint must have actual contents now.
	if [[ -z "$(find "${rootMountLocation}" -mindepth 1 -maxdepth 1 -print -quit 2>/dev/null)" ]]; then
		fLogError "In ${meName}.${FUNCNAME[0]}(): All datasets report mounted, but '${rootMountLocation}' is empty. Refusing login."
		return 1
	fi

	fLog "✔️ All ${mountedCount} of '${targetUser}'s dataset(s) are mounted; '${rootMountLocation}' has contents. Mission accomplished."

	## Call logging if it exists. Add any logging system you want here, or just remove this part if you don't want it.
	local -r logExec="/usr/local/bin/x9/sh/x9startup-log"
	[[ -x "${logExec}" ]]  &&  "${logExec}"  "${0}"  note  "Ran."  || true

	fLog "[ ${meName} done. ]"
	return 0

}


fMain "$@"


##	History:
##		- 20221219: Created.
##		- 20221220: Bug fixes.
##		- 20230119:
##			- Stuffed inside a function for better variable scope/security.
##			- More error and sanity checking.
##			- More output for troubleshooting.
##		- 20230121-25:
##			- Added prop 'x9.custom.automount:dir'
##			- Support for 'legacy' mount option.
##		- 20230127: Fixed bug where missing 'datamash', which is essential, didn't abort script.
##		- 20260226:
##			- Fixed error in PATH setting that could have caused a bug.
##			- Added more output for troubleshooting.
##		- 20260227:
##			- No separate 'legacy' mount method. The syntax (with a `-t` argument?) seems to have changed since this was first written.
##			- Added attempt at mounting children of freshly-decrypted/mounted filesystem.
##				- Just uses `-R` as part of regular mount command.
##			- Added call to logging if it exists.
##		- 20260329:
##			- Copied original to v2, to add salt feature, and refactor in the future.
##			- Append contents of /etc/cryptkeys/zfs_pam_longsalt_${HOSTNAME}.txt to password, if file exists.
##			- Proceed even if there are folders in underlying mount location; just not if no files.
##		- 20260812: Full rewrite.
##			- Replaced the one big piped dataset-discovery command (and its 'datamash' dependency) with a
##			  simple readable loop over `zfs get -s local`.
##			- Pre-existing files/folders in a mountpoint no longer abort the mount: they are moved (never
##			  deleted) into a '.tkz_premount-quarantine' folder next to the mountpoint.
##			- Every dataset in the user's tree (canmount != off) is now mounted and verified individually;
##			  if ANY fails, the script exits non-zero so PAM ('requisite') refuses the login.
##			- Key loading is now explicit and verified via 'keystatus', against the 'encryptionroot'.
##			- All important output also goes to syslog (PAM's 'quiet' discards stdout).
##			- Manual test mode: 'sudo tkz_zfs-crypthome_login <username>' (prompts for password only if needed).
##			- 'set -euo pipefail' throughout.
##			- Shebang is now '#!/bin/bash -p': under setuid PAM services (su et al), plain bash silently
##			  dropped euid root, making 'zfs load-key'/'zfs mount' fail. Found via end-to-end PAM testing;
##			  the old version had the same latent bug but 'optional' hid it.
