#!/bin/bash
#  shellcheck disable=2155  ## Disable check to 'Declare and assign separately to avoid masking return values'.

##	Purpose:
##		- Create users whose home is its own ZFS dataset, plain or encrypted.
##		- Change a password and the encrypted home's ZFS key together, so login keeps unlocking the home.
##		- Move an existing plain home into a new encrypted dataset.
##	Notes:
##		- An encrypted home is unlocked at login by tkz_zfs-crypthome_login, using the login password as the
##		  ZFS key. So the 2 must always match. Use 'tkz_user passwd' instead of plain 'passwd' for those users.
##		- The ZFS key is built the same way the login helper builds it, including the optional salt file.
##	Copyright and license ...: Toward bottom of this file.
##	History .................: At bottom of this file.

set -euo pipefail

declare -r meName="$(basename "${0}")"
declare -r custProp_UserName="x9.custom.automount:user"
declare -r pwdLongSaltFile="/etc/cryptkeys/zfs_pam_longsalt_${HOSTNAME}.txt"  ## Same file the login helper reads.
declare -ra encChildren=(".cache" "tmp" "var")  ## Separate datasets, left out of auto-snapshots.

fShowHelp(){
	cat <<EOF

Usage:
  ${meName} add <user> [--encrypt] [--admin] [--groups g1,g2] [--uid N] [--comment TEXT]
  ${meName} passwd <user>
  ${meName} migrate <user>
  ${meName} status [user]

  add      Create a home dataset under the dataset mounted at /home, then the user, then set a password.
           --encrypt   Encrypted home, unlocked at login with the password.
           --admin     Also add to sudo and adm.
  passwd   Change the login password. For an encrypted home, change its ZFS key to match, in one step.
  migrate  Move a user's plain home (a folder, or a plain dataset) into a new encrypted dataset.
           The user must be logged out, with nothing left running. The old home is kept, renamed,
           until you delete it. If it fails partway, the old home and password are put back.
  status   Show users with a home dataset, and whether each is encrypted, unlocked and mounted.

Must run as root.
EOF
}

fDie(){ echo -e "${meName}: ERROR: $*" >&2; exit 1; }
fSay(){ echo "[ $* ]"; }
fLog(){ echo -e "$*"; }  ## For fIsUserInUse, same as in the watchdog.

fHomeParent(){
	## The dataset mounted at /home.
	local p=""
	p="$(zfs list -H -o name,mountpoint -t filesystem 2>/dev/null | awk '$2=="/home"{print $1; exit}')"
	[[ -n "${p}" ]]  ||  fDie "No ZFS dataset is mounted at /home."
	echo "${p}"
}

fZfsKeyFor(){
	## $1: password. Echoes the ZFS key the login helper would use for it.
	local k="$1"  salt=""
	if [[ -f "${pwdLongSaltFile}" ]]; then
		salt="$(tr -d '\n' < "${pwdLongSaltFile}" 2>/dev/null || true)"
		[[ -n "${salt}" ]]  &&  k="${k}_${salt}"
	fi
	printf '%s' "${k}"
}

fReadNewPassword(){
	## Sets global $newPwd. Prompts twice.
	local p1="" p2=""
	read -r -s -p "New password for '$1': " p1; echo
	read -r -s -p "Again: " p2; echo
	[[ "${p1}" == "${p2}" ]]  ||  fDie "Passwords don't match."
	[[ ${#p1} -ge 8 ]]  ||  fDie "Use at least 8 characters. ZFS won't accept a shorter key."
	newPwd="${p1}"
}

fUserExists(){ getent passwd "$1" >/dev/null; }

## Copy of the one in tkz_zfs-crypthome_logout-watchdog. Keep the 2 the same; tests/tkz_user_migrate.bash
## fails if they differ. Each script gets deployed on its own, so neither can source the other.
function fIsUserInUse(){
	## Returns 0 (in use - do not touch) if the user looks logged in by any means, else 1.
	local -r userName="$1"
	local -r state="$(loginctl show-user "${userName}" --property=State --value 2>/dev/null || true)"
	## 'closing' is left out on purpose: no session is active any more, and the unit's ExecStartPre
	## sleep gives it time to finish.
	case "${state}" in
		"active"|"online"|"opening")
			fLog "-  loginctl reports user '${userName}' State=${state}."
			return 0
		;;
		"lingering")
			fLog "-  User '${userName}' has linger enabled (State=lingering); leaving their services alone."
			return 0
		;;
	esac
	## utmp misses GUI sessions, but if it does show a login, believe it.
	## awk reads to the end: an early-exiting 'grep -q' here can SIGPIPE the writer, and pipefail
	## turns that match into a miss.
	if who 2>/dev/null | U="${userName}" awk '$1==ENVIRON["U"] {found=1} END {exit !found}'; then
		fLog "-  'who' reports user '${userName}' as logged in."
		return 0
	fi
	## 'su -' opens no logind session and writes no utmp record, but its shell has a controlling TTY.
	## Unlike "has any process", a TTY can't let a stray daemon keep the home mounted forever.
	local -r userTty="$(ps -o tty= -u "${userName}" 2>/dev/null | awk '$1!="?" && tty=="" {tty=$1} END {print tty}' || true)"
	if [[ -n "${userTty}" ]]; then
		fLog "-  User '${userName}' has a process on ${userTty} (e.g. 'su -'); treating as logged in."
		return 0
	fi
	return 1
}

fRefuseIfInUse(){
	## The watchdog's test, plus any process at all. The watchdog can't wait on a stray daemon forever,
	## but migrate can ask, and a cron job writing after the copy loses that write.
	fIsUserInUse "$1"  &&  fDie "'$1' is logged in. Log them out first."
	local procs=""
	procs="$(ps -o pid=,comm= -u "$1" 2>/dev/null || true)"
	[[ -z "${procs}" ]]  ||  fDie "'$1' still has processes running:\n${procs}\nStop them first, for example with: loginctl terminate-user $1"
}

fUnmountTree(){
	## $1: dataset. Unmounts it and whatever is mounted under it, deepest first.
	local d=""
	while read -r d; do
		zfs unmount "${d}"  ||  return 1
	done < <(zfs list -H -r -o name,mounted "$1" 2>/dev/null | awk -F'\t' '$2=="yes" {print $1}' | tac)
}

fCreateEncChildren(){
	## $1: user dataset; $2: user
	local c=""
	for c in "${encChildren[@]}"; do
		zfs create -o canmount=on -o mountpoint="/home/$2/${c}" -o com.sun:auto-snapshot=false "$1/${c}"
	done
}

fFixOwnership(){
	## $1: user. Owner, modes, skel files.
	local u="$1"  g=""
	g="$(id -gn "${u}")"
	cp -rn /etc/skel/. "/home/${u}/" 2>/dev/null || true
	chown -R "${u}:${g}" "/home/${u}"
	chmod 750 "/home/${u}"
	local c=""
	## Not through a symlink; migrate leaves those in place, pointing who knows where.
	for c in "${encChildren[@]}"; do [[ -d "/home/${u}/${c}" && ! -L "/home/${u}/${c}" ]] && chmod 700 "/home/${u}/${c}"; done
	return 0
}

fCmdAdd(){
	local u="" enc=0 admin=0 groups="audio,video,plugdev,users" uid="" comment=""
	while (( $# )); do
		case "$1" in
			--encrypt) enc=1 ;;
			--admin)   admin=1 ;;
			--groups)  shift; groups="${groups},${1:?}" ;;
			--uid)     shift; uid="${1:?}" ;;
			--comment) shift; comment="${1:?}" ;;
			-*)        fDie "Unknown option '$1'." ;;
			*)         [[ -z "${u}" ]] || fDie "Only one user name, please."; u="$1" ;;
		esac
		shift
	done
	[[ -n "${u}" ]]  ||  fDie "Missing user name."
	[[ "${u}" =~ ^[a-z_][a-z0-9_-]*$ ]]  ||  fDie "'${u}' isn't a valid user name."
	fUserExists "${u}"  &&  fDie "User '${u}' already exists. To encrypt their home, use: ${meName} migrate ${u}"
	((admin))  &&  groups="${groups},sudo,adm"

	local parent=""; parent="$(fHomeParent)"  ## Not "local x=$(...)": that hides fDie's exit.
	local -r ds="${parent}/${u}"
	zfs list -H "${ds}" &>/dev/null  &&  fDie "Dataset '${ds}' already exists."
	[[ -e "/home/${u}" ]]  &&  fDie "'/home/${u}' already exists."

	local newPwd=""
	fReadNewPassword "${u}"

	if ((enc)); then
		fSay "Creating encrypted dataset '${ds}'"
		fZfsKeyFor "${newPwd}" | zfs create -o encryption=aes-256-gcm -o keyformat=passphrase -o keylocation=prompt -o pbkdf2iters=600000 \
			-o canmount=noauto -o mountpoint="/home/${u}" -o "${custProp_UserName}=${u}" -o org.openzfs.systemd:ignore=on "${ds}"
		zfs mount "${ds}"
		fCreateEncChildren "${ds}" "${u}"
	else
		fSay "Creating dataset '${ds}'"
		zfs create -o canmount=on -o mountpoint="/home/${u}" "${ds}"
	fi

	fSay "Creating user '${u}'"
	useradd ${uid:+-u "${uid}"} -U -c "${comment}" -s /bin/bash -d "/home/${u}" -M -G "${groups}" "${u}"
	printf '%s:%s\n' "${u}" "${newPwd}" | chpasswd
	fFixOwnership "${u}"

	if ((enc)); then
		## Lock it again. It gets unlocked at login.
		zfs unmount "${ds}"
		zfs unload-key "${ds}"
		fSay "Done. '${u}' has an encrypted home, unlocked at login."
	else
		fSay "Done. '${u}' has a plain home dataset."
	fi
}

fCmdPasswd(){
	local -r u="${1:-}"
	[[ -n "${u}" ]]  ||  fDie "Missing user name."
	fUserExists "${u}"  ||  fDie "No user '${u}'."
	local parent=""; parent="$(fHomeParent)"
	local -r ds="${parent}/${u}"
	local encRoot=""
	encRoot="$(zfs get -H -o value encryptionroot "${ds}" 2>/dev/null || true)"

	if [[ -z "${encRoot}" || "${encRoot}" == "-" ]]; then
		passwd "${u}"
		return
	fi
	[[ "${encRoot}" == "${ds}" ]]  ||  fDie "'${ds}' inherits its key from '${encRoot}'. Not a per-user key; change it by hand."

	local -i loadedHere=0
	if [[ "$(zfs get -H -o value keystatus "${ds}")" != "available" ]]; then
		local oldPwd=""
		read -r -s -p "Current password for '${u}': " oldPwd; echo
		fZfsKeyFor "${oldPwd}" | zfs load-key "${ds}"  ||  fDie "Wrong current password (the home's key didn't load)."
		loadedHere=1
	fi

	local newPwd=""
	fReadNewPassword "${u}"

	fSay "Changing the ZFS key of '${ds}'"
	fZfsKeyFor "${newPwd}" | zfs change-key -o keyformat=passphrase -o keylocation=prompt "${ds}"
	fSay "Changing the login password"
	if ! printf '%s:%s\n' "${u}" "${newPwd}" | chpasswd; then
		echo "${meName}: WARNING: the ZFS key changed, but the login password didn't. Run this again before '${u}' logs out." >&2
		exit 1
	fi
	((loadedHere))  &&  zfs unload-key "${ds}" 2>/dev/null || true
	fSay "Done. Password and home key both changed."
}

## What a migrate in flight has changed, for fMigrateRollback. Global, since an EXIT trap runs after the
## function's locals are gone.
declare -A __mig=([active]=0)

fMigrateRollback(){
	## EXIT trap for migrate. Puts back the old home and password, then destroys the copy, so a failure
	## partway can't lock the user out. Steps run in reverse, each only if its forward step happened.
	[[ "${__mig[active]}" == 1 ]]  ||  return 0
	__mig[active]=0
	trap '' INT TERM HUP
	set +eu
	local -r u="${__mig[user]}"  ds="${__mig[ds]}"  home="${__mig[home]}"  tmpDs="${__mig[tmpDs]}"
	local -i newOut=1  oldBack=1  pwdBack=1
	echo -e "\n${meName}: migrate stopped partway. Putting '${u}' back the way they were." >&2

	if [[ "${__mig[pwdChanged]:-}" == 1 ]]; then
		printf '%s:%s\n' "${u}" "${__mig[oldHash]}" | chpasswd -e  ||  pwdBack=0
	fi
	if [[ "${__mig[newPlaced]:-}" == 1 ]]; then
		{ fUnmountTree "${ds}" && zfs rename "${ds}" "${tmpDs}"; }  ||  newOut=0
	fi

	if ((newOut == 0)); then
		oldBack=0
	elif [[ "${__mig[oldMoved]:-}" == 1 ]]; then
		[[ -d "${home}" && ! -L "${home}" ]]  &&  rmdir "${home}"
		mv -T "${__mig[oldKeep]}" "${home}"  ||  oldBack=0
	elif [[ "${__mig[oldUnmounted]:-}" == 1 ]]; then
		if [[ "${__mig[oldRenamed]:-}" == 1 ]]; then
			zfs rename "${__mig[oldDs]}" "${ds}"  ||  oldBack=0
		fi
		if ((oldBack)); then
			if [[ "${__mig[oldMpSrc]}" == "local" ]]; then
				zfs set mountpoint="${__mig[oldMp]}" "${ds}"  ||  oldBack=0
			else
				zfs inherit mountpoint "${ds}"  ||  oldBack=0
			fi
			zfs set canmount="${__mig[oldCanmount]}" "${ds}"  ||  oldBack=0
			local d=""
			while read -r d; do
				[[ -z "${d}" || "$(zfs get -H -o value mounted "${d}")" == "yes" ]]  &&  continue
				zfs mount "${d}"  ||  oldBack=0
			done <<<"${__mig[oldMounted]}"
		fi
	fi

	## The copy goes only once the original is back, and only if it's still the dataset made this run.
	local -i copyGone=1
	if [[ "${__mig[tmpMade]:-}" == 1 ]]; then
		copyGone=0
		if ((oldBack)) && fUnmountTree "${tmpDs}" \
			&& [[ "$(zfs get -H -o value guid "${tmpDs}" 2>/dev/null)" == "${__mig[tmpGuid]}" ]] \
			&& zfs destroy -r "${tmpDs}"; then
			copyGone=1
		fi
		rmdir "${__mig[tmpMnt]}" 2>/dev/null
	fi

	if ((oldBack && pwdBack && copyGone)); then
		echo "${meName}: rolled back. '${u}' has their old home and password." >&2
		return 0
	fi
	echo "${meName}: rollback didn't finish. Nothing has the automount property, so login still works. Left to check by hand:" >&2
	((pwdBack))   ||  echo "  - The password couldn't be put back. Set it with: passwd ${u}" >&2
	((oldBack))   ||  echo "  - The old home is still at '${__mig[oldKeep]}' or dataset '${__mig[oldDs]}'. '${home}' may be the new copy." >&2
	((copyGone))  ||  echo "  - The new copy wasn't removed. Once the old home is back: zfs destroy -r '${tmpDs}'" >&2
	return 0
}

fCmdMigrate(){
	local -r u="${1:-}"
	[[ -n "${u}" ]]  ||  fDie "Missing user name."
	fUserExists "${u}"  ||  fDie "No user '${u}'."
	fRefuseIfInUse "${u}"
	local parent=""; parent="$(fHomeParent)"
	local -r ds="${parent}/${u}"
	local -r home="/home/${u}"
	local -r stamp="$(date +%Y%m%d-%H%M%S)"

	local enc=""
	enc="$(zfs get -H -o value encryption "${ds}" 2>/dev/null || true)"
	[[ -n "${enc}" && "${enc}" != "off" ]]  &&  fDie "'${ds}' is already encrypted."
	[[ -L "${home}" ]]  &&  fDie "'${home}' is a symlink. Put the real folder there first."
	[[ -d "${home}" ]]  ||  fDie "'${home}' doesn't exist."
	local -i isDataset=0
	if zfs list -H "${ds}" &>/dev/null; then
		isDataset=1
		[[ "$(zfs get -H -o value mounted "${ds}")" == "yes" ]]  ||  fDie "'${ds}' isn't mounted, so '${home}' is empty. Mount it first."
	fi
	command -v rsync &>/dev/null  ||  fDie "rsync isn't installed."
	local oldHash=""
	oldHash="$(getent shadow "${u}" | cut -d: -f2 || true)"
	[[ -n "${oldHash}" ]]  ||  fDie "Can't read the password hash of '${u}', so a failed migrate couldn't put it back."

	local newPwd=""
	echo "The new encrypted home is unlocked with this login password, so it replaces the current one."
	fReadNewPassword "${u}"

	local -r tmpDs="${parent}/${u}_migrating-${stamp}"
	local -r tmpMnt="/run/${meName}-${u}-${stamp}"
	local -r oldDs="${ds}_pre-encrypt-${stamp}"
	local -r oldKeep="${home}.pre-encrypt-${stamp}"
	__mig=([active]=1 [user]="${u}" [ds]="${ds}" [home]="${home}" [tmpDs]="${tmpDs}" [tmpMnt]="${tmpMnt}" [oldDs]="${oldDs}" [oldKeep]="${oldKeep}" [oldHash]="${oldHash}")
	trap fMigrateRollback EXIT
	trap 'exit 130' INT; trap 'exit 143' TERM; trap 'exit 129' HUP

	## No automount property yet. Login and the watchdog both go by it, so it's set last, below.
	fSay "Creating encrypted dataset, mounted at '${tmpMnt}' for the copy"
	fZfsKeyFor "${newPwd}" | zfs create -o encryption=aes-256-gcm -o keyformat=passphrase -o keylocation=prompt -o pbkdf2iters=600000 \
		-o canmount=noauto -o mountpoint="${tmpMnt}" -o org.openzfs.systemd:ignore=on "${tmpDs}"
	__mig[tmpMade]=1
	__mig[tmpGuid]="$(zfs get -H -o value guid "${tmpDs}")"
	zfs mount "${tmpDs}"

	fSay "Copying '${home}'"
	rsync -aHAX --numeric-ids "${home}/" "${tmpMnt}/"
	## Anything written to the old home from here on would be lost.
	fRefuseIfInUse "${u}"

	if ((isDataset)); then
		fSay "Keeping old dataset as '${oldDs}' (canmount=noauto)"
		__mig[oldMp]="$(zfs get -H -o value mountpoint "${ds}")"
		__mig[oldMpSrc]="$(zfs get -H -o source mountpoint "${ds}")"
		__mig[oldCanmount]="$(zfs get -H -o value canmount "${ds}")"
		__mig[oldMounted]="$(zfs list -H -r -o name,mounted "${ds}" | awk -F'\t' '$2=="yes" {print $1}')"
		__mig[oldUnmounted]=1
		fUnmountTree "${ds}"
		zfs rename "${ds}" "${oldDs}"
		__mig[oldRenamed]=1
		zfs set canmount=noauto mountpoint="${oldKeep}" "${oldDs}"
		## tkz_zfs-mount leaves mountpoint dirs immutable and empty; free the name for the new mount.
		if [[ -d "${home}" && ! -L "${home}" ]]; then
			chattr -i "${home}" 2>/dev/null || true
			rmdir "${home}" 2>/dev/null || true
		fi
	else
		fSay "Keeping old folder as '${oldKeep}'"
		chattr -i "${home}" 2>/dev/null || true
		mv -T "${home}" "${oldKeep}"
		__mig[oldMoved]=1
	fi

	fSay "Putting the encrypted dataset at '${home}'"
	zfs unmount "${tmpDs}"
	zfs rename "${tmpDs}" "${ds}"
	__mig[newPlaced]=1
	zfs set mountpoint="${home}" "${ds}"
	zfs mount "${ds}"
	rmdir "${tmpMnt}" 2>/dev/null || true

	## The cache, tmp and var subfolders become their own datasets. Move what was copied into them.
	## A symlink, or a file, is left as it is. Following a link would move whatever it points at into
	## this home, and the chown below would give it to the user.
	local c=""  parked=""
	for c in "${encChildren[@]}"; do
		if [[ -L "${home}/${c}" || ( -e "${home}/${c}" && ! -d "${home}/${c}" ) ]]; then
			fSay "Leaving '${home}/${c}' as it is, since it isn't a folder"
			continue
		fi
		parked=""
		if [[ -d "${home}/${c}" ]]; then
			parked="${home}/${c}.migrating-${stamp}"
			mv -T "${home}/${c}" "${parked}"
		fi
		zfs create -o canmount=on -o mountpoint="${home}/${c}" -o com.sun:auto-snapshot=false "${ds}/${c}"
		if [[ -n "${parked}" ]]; then
			( shopt -s dotglob nullglob; mv "${parked}"/* "${home}/${c}/" ) || true
			rmdir "${parked}" 2>/dev/null || true
		fi
	done
	fFixOwnership "${u}"

	fSay "Changing the login password"
	__mig[pwdChanged]=1
	printf '%s:%s\n' "${u}" "${newPwd}" | chpasswd
	## The commit point. From here, login unlocks this home with the new password.
	zfs set "${custProp_UserName}=${u}" "${ds}"
	__mig[active]=0

	if ! { fUnmountTree "${ds}" && zfs unload-key "${ds}"; }; then
		echo "${meName}: WARNING: couldn't lock '${ds}' again. The watchdog will, once '${u}' is logged out." >&2
	fi
	fSay "Done. '${u}' now has an encrypted home."
	echo "The old home is still there, as '${oldKeep}' or its dataset. Delete it after '${u}' has logged in and checked their files."
}

fCmdStatus(){
	local parent=""; parent="$(fHomeParent)"
	local only="${1:-}"
	printf '%-14s %-12s %-12s %-8s %s\n' USER ENCRYPTED KEY MOUNTED DATASET
	local name="" enc="" key="" mounted=""
	while IFS=$'\t' read -r name enc key mounted; do
		[[ "${name}" == "${parent}" ]] && continue
		local u="${name#"${parent}"/}"
		[[ "${u}" == */* ]] && continue
		[[ -n "${only}" && "${u}" != "${only}" ]] && continue
		printf '%-14s %-12s %-12s %-8s %s\n' "${u}" "${enc}" "${key}" "${mounted}" "${name}"
	done < <(zfs list -H -r -t filesystem -o name,encryption,keystatus,mounted "${parent}")
}

fMain(){
	local -r cmd="${1:-}"
	case "${cmd}" in
		''|-h|--help|help) fShowHelp; return 0 ;;
	esac
	((EUID == 0))  ||  fDie "Must run as root."
	shift
	case "${cmd}" in
		add)     fCmdAdd "$@" ;;
		passwd)  fCmdPasswd "$@" ;;
		migrate) fCmdMigrate "$@" ;;
		status)  fCmdStatus "$@" ;;
		*)       fShowHelp; fDie "Unknown command '${cmd}'." ;;
	esac
}

fMain "$@"


